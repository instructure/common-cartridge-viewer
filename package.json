{
  "name": "common-cartridge-viewer",
  "version": "0.1.1",
  "private": true,
  "dependencies": {
    "@instructure/ui": "^11.7.10",
    "@lingui/core": "^5.9.5",
    "@lingui/react": "^5.9.5",
    "@sentry/react": "^10.78.0",
    "dompurify": "2.5.4",
    "file-saver": "^2.0.0",
    "lodash": "^4.18.1",
    "pretty-bytes": "^5.1.0",
    "query-string": "5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-github-corner": "^2.5.0",
    "react-router": "^7.18.5",
    "react-router-dom": "^7.18.5",
    "react-scripts": "^5.0.1",
    "whatwg-fetch": "^3.0.0"
  },
  "scripts": {
    "add-locale": "lingui add-locale",
    "build": "npm run compile && react-scripts build",
    "compile": "lingui compile",
    "eject": "react-scripts eject",
    "extract": "lingui extract",
    "start": "react-scripts start",
    "test-all": "testcafe chrome,firefox,safari ./tests/test.* --app \"node_modules/.bin/superstatic -p 5000 ./build -s\"",
    "test-chrome": "testcafe chrome ./tests/test.* --app \"node_modules/.bin/superstatic -p 5000 ./build -s\"",
    "test-firefox": "testcafe firefox ./tests/test.* --app \"node_modules/.bin/superstatic -p 5000 ./build -s\"",
    "test-safari": "testcafe safari ./tests/test.* --app \"node_modules/.bin/superstatic -p 5000 ./build -s\"",
    "test": "testcafe chrome,firefox ./tests/test.* --app \"node_modules/.bin/superstatic -p 5000 ./build -s\"",
    "test-screenshots": "testcafe chrome ./tests/test.* --app \"node_modules/.bin/superstatic -p 5000 ./build -s\" -s takeOnFails=true,path=./tests/screenshots,fullPage=true",
    "test-chrome-headless": "testcafe chrome:headless ./tests/test.*  --page-load-timeout 10000 --assertion-timeout 10000 --app \"node_modules/.bin/superstatic -p 5000 ./build -s\"",
    "test-headless": "testcafe chrome:headless,firefox:headless ./tests/test.*  --page-load-timeout 10000 --assertion-timeout 10000 --app \"node_modules/.bin/superstatic -p 5000 ./build -s\"",
    "test-ci": "testcafe \"chrome:headless --no-sandbox --disable-gpu\" ./tests/test.* --page-load-timeout 30000 --assertion-timeout 30000 --selector-timeout 30000 --quarantine-mode attemptLimit=3,successThreshold=1 --screenshots path=tests/screenshots,takeOnFails=true --reporter spec,xunit:report/testcafe.xml --app \"node_modules/.bin/superstatic -p 5000 ./build -s\"",
    "e2e": "playwright test",
    "e2e:edge": "CCV_BASE_URL=https://common-cartridge-viewer-edge.netlify.app playwright test",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,css}\""
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css}": [
      "prettier --write",
      "git add"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.2.2",
    "@lingui/babel-plugin-lingui-macro": "^5.9.5",
    "@lingui/cli": "^5.9.5",
    "@playwright/test": "^1.61.1",
    "babel-core": "^7.0.0-bridge.0",
    "babel-plugin-macros": "^3.1.0",
    "husky": "^1.3.1",
    "lint-staged": "^8.1.0",
    "prettier": "^3.9.4",
    "superstatic": "^6.0.4",
    "testcafe": "^3.7.4"
  },
  "browserslist": [
    "last 2 version",
    "ie 11",
    "not ie <= 10",
    "not op_mini all"
  ]
}
